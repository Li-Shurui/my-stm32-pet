#!/bin/sh
# petctl - control the ATK-MP157 desktop pet from the serial console.
#
# The pet listens on the FIFO /run/pet.cmd (created by the pet service).
# State replies also land in the pet's journal: journalctl -u atk-pet -n 5
#
# Usage: petctl <command> [args]
FIFO=/run/pet.cmd

usage() {
    cat <<'EOF'
petctl - desktop pet controller

  summon               summon the pet out of its launcher icon
  exit                 send the pet back to its icon
  sleep                put the pet to sleep (releases the touchscreen)
  wake                 wake the pet up
  dance                the pet dances for ~6 seconds
  happy                the pet hops with hearts
  say [mood|number]    the pet shows a kaomoji speech bubble
                       (see: petctl list)
  list                 list all kaomoji (number, mood, content)
  food [x y]           drop cat food at x,y (or a random spot)
  butterfly            release a butterfly
  goto x y             the pet walks to x,y
  status               show mode/state/position
  help                 this text

examples:
  petctl summon
  petctl list
  petctl say happy
  petctl say love
  petctl say 7
  petctl dance
  petctl food 500 300
  petctl status
EOF
}

case "$1" in
    ""|-h|--help|help)
        usage
        exit 0
        ;;
esac

if [ ! -p "$FIFO" ]; then
    echo "petctl: pet is not running (no $FIFO)" >&2
    echo "petctl: start it with: systemctl start atk-pet" >&2
    exit 1
fi

echo "$*" > "$FIFO" || {
    echo "petctl: failed to write to $FIFO" >&2
    exit 1
}

# kaomoji feedback straight in the shell
case "$1" in
    list)
        sleep 0.5
        if [ -f /run/pet.kaomoji ]; then
            echo "kaomoji list:"
            cat /run/pet.kaomoji
        else
            echo "petctl: no list file (pet busy?)" >&2
        fi
        ;;
    say)
        sleep 0.5
        if [ -f /run/pet.last ]; then
            printf 'pet says: '
            cat /run/pet.last
        fi
        ;;
    *)
        ;;
esac
exit 0
